# Copia a .env para desarrollo local. En Coolify estas variables se definen en la app "backend".

PORT=3000

# Postgres (en Coolify: el recurso de base de datos; usa su URL interna)
DATABASE_URL=postgres://plebes:plebes@localhost:5432/plebes

# Secreto para firmar sesiones. Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_TTL=8h

# Dominios del frontend permitidos por CORS, separados por coma (sin barra final)
CORS_ORIGINS=http://localhost:8080

# Primer usuario administrador (solo se crea si la tabla de usuarios está vacía)
ADMIN_EMAIL=dueno@example.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Almacenamiento S3 (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=platillos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# URL pública desde la que el navegador lee las imágenes (la del MinIO, sin barra final)
S3_PUBLIC_URL=http://localhost:9000
